# ===================================================================
# API KEYS (HIGHLY SENSITIVE)
# ===================================================================
# SendGrid API Key for email delivery
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your-sendgrid-api-key-here

# OpenAI API Key for AI chat functionality
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Models Configuration (non-sensitive but kept here for convenience)
# Available models: https://platform.openai.com/docs/models
OPENAI_CHAT_MODEL=gpt-5-mini-2025-08-07
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===================================================================
# DATABASE CREDENTIALS (SENSITIVE)
# ===================================================================
# PostgreSQL database host (e.g., localhost, db.example.com)
PGHOST=localhost

# PostgreSQL database port (default: 5432)
PGPORT=5432

# PostgreSQL database name
PGDATABASE=laptop_repair

# PostgreSQL username
PGUSER=postgres

# PostgreSQL password
PGPASSWORD=your-secure-password-here

# ===================================================================
# SECURITY CREDENTIALS (MEDIUM SENSITIVITY)
# ===================================================================
# Staff users for authentication (format: username:password,username:password)
APP_SECURITY_STAFF_USERS=staff:staff123,admin:admin123,manager:manager123

# ===================================================================
# EMAIL CONFIGURATION (LOW SENSITIVITY)
# ===================================================================
# From email address for system emails
APP_EMAIL_FROM=your-email@example.com

# CC email address for system emails (optional)
APP_EMAIL_CC=your-cc-email@example.com

# ===================================================================
# OPTIONAL CUSTOMIZATION (NON-SENSITIVE)
# ===================================================================
# Shop name for the application
APP_SHOP_NAME=Laptop Repair Shop

# Public base URL for the application (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8080